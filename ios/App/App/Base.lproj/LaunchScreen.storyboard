<?xml version="1.0" encoding="UTF-8"?>
<!--
    NOURA — Startbildschirm.

    Er zeigt den Intro-Screen in seinem Anfangszustand: den Aurora-
    Hintergrund (Splash) und darauf das App-Icon (SplashIcon). Beide Bilder
    erzeugt tools/app-icon/build-icon.py, den Hintergrund aus den App-Stilen
    selbst.

    Das Icon liegt bewusst NICHT im Hintergrundbild, sondern als eigene
    Ebene: nur so laesst sich seine Groesse an die Bildschirmhoehe binden.
    Die beiden Multiplikatoren unten sind dieselben Zahlen wie die Token
    intro-icon und intro-cy in src/styles/global.css und ICON_FRAC/ICON_CY
    in build-icon.py:

        Hoehe   = 0.176 * Bildschirmhoehe   (150px auf 393x852)
        Mitte y = 0.472 * Bildschirmhoehe   (y = 402)

    — damit das Icon auf jedem Geraet genau dort steht, wo der Intro-Screen
    es danach zeigt. Ein ins Bild gebackenes Icon waere nur auf 393x852
    richtig gewesen, weil scaleAspectFill das Bild mit der Bildschirmhoehe
    skaliert. Wer eine der Zahlen aendert, aendert alle drei Stellen.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="17132" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina4_7" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="17105"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="rootView">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="Splash" translatesAutoresizingMaskIntoConstraints="NO" id="bgImage"/>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="SplashIcon" translatesAutoresizingMaskIntoConstraints="NO" id="iconImage">
                                <constraints>
                                    <constraint firstAttribute="width" secondItem="iconImage" secondAttribute="height" multiplier="1:1" id="iconSquare"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safeArea"/>
                        <color key="backgroundColor" red="0.31764705882352939" green="0.24705882352941178" blue="0.43137254901960786" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="bgImage" firstAttribute="top" secondItem="rootView" secondAttribute="top" id="bgTop"/>
                            <constraint firstItem="bgImage" firstAttribute="leading" secondItem="rootView" secondAttribute="leading" id="bgLeading"/>
                            <constraint firstAttribute="trailing" secondItem="bgImage" secondAttribute="trailing" id="bgTrailing"/>
                            <constraint firstAttribute="bottom" secondItem="bgImage" secondAttribute="bottom" id="bgBottom"/>
                            <constraint firstItem="iconImage" firstAttribute="centerX" secondItem="rootView" secondAttribute="centerX" id="iconCenterX"/>
                            <constraint firstItem="iconImage" firstAttribute="centerY" secondItem="rootView" secondAttribute="bottom" multiplier="0.472" id="iconCenterY"/>
                            <constraint firstItem="iconImage" firstAttribute="height" secondItem="rootView" secondAttribute="height" multiplier="0.176" id="iconHeight"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="Splash" width="1179" height="2556"/>
        <image name="SplashIcon" width="512" height="512"/>
    </resources>
</document>
